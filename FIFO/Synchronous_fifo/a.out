    %load/v 40, v011A7580_0, 3; Only need 3 of 4 bits
; Save base=40 wid=3 in lookaside.
    %ix/get 3, 40, 3;
    %jmp/1 t_0, 4;
    %ix/load 0, 32, 0; word width
    %ix/load 1, 0, 0; part off
    %assign/av v011A7898, 0, 8;
