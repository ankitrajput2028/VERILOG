    %set/v v011E60C0_0, 0, 1;
    %set/v v011A7948_0, 0, 1;
    %set/v v011E65E8_0, 0, 1;
    %set/v v011E6278_0, 0, 1;
    %vpi_call 2 23 "$display", "Scenario1 checking empty port";
