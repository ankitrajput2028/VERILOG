    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v011A7840_0, 1;
    %load/v 9, v011A78F0_0, 1;
    %and 8, 9, 1;
    %load/v 9, v011A76E0_0, 1;
    %inv 9, 1;
    %and 8, 9, 1;
